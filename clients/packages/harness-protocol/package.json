{
  "name": "@harness/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Wire protocol types, client, and reducer shared by the harness web and mobile clients",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "tsup": "8.5.1"
  }
}
